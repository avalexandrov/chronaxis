{
  "name": "@chronaxis/react",
  "version": "0.1.0",
  "description": "Thin React adapter for the Chronaxis timeline engine.",
  "keywords": ["timeline", "typescript", "visualization", "scheduler", "react"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avalexandrov/chronaxis.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/avalexandrov/chronaxis#readme",
  "bugs": "https://github.com/avalexandrov/chronaxis/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit"
  },
  "dependencies": {
    "@chronaxis/browser": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
