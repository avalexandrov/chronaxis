{
  "name": "@chronaxis/browser",
  "version": "0.1.0",
  "description": "Accessible interactive DOM/SVG timelines powered by Chronaxis core.",
  "keywords": ["timeline", "typescript", "visualization", "scheduler", "browser"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avalexandrov/chronaxis.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/avalexandrov/chronaxis#readme",
  "bugs": "https://github.com/avalexandrov/chronaxis/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chronaxis/core": "0.1.0"
  }
}
