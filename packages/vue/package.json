{
  "name": "@chronaxis/vue",
  "version": "0.3.0",
  "description": "Thin Vue 3 adapter for the Chronaxis timeline engine.",
  "keywords": ["timeline", "typescript", "visualization", "scheduler", "vue"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avalexandrov/chronaxis.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/avalexandrov/chronaxis#readme",
  "bugs": "https://github.com/avalexandrov/chronaxis/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "vite build && rm -f tsconfig.tsbuildinfo && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.type-tests.json --noEmit"
  },
  "dependencies": {
    "@chronaxis/browser": "0.3.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vue": "^3.5.43"
  }
}
