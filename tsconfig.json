{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@chronaxis/core": ["./packages/core/src/index.ts"],
      "@chronaxis/browser": ["./packages/browser/src/index.ts"],
      "@chronaxis/react": ["./packages/react/src/index.ts"]
    }
  }
}
